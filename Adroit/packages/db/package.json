{
    "name": "@adroit/db",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./identity": {
            "types": "./dist/identity/index.d.ts",
            "default": "./dist/identity/index.js"
        },
        "./projects": {
            "types": "./dist/projects/index.d.ts",
            "default": "./dist/projects/index.js"
        }
    },
    "scripts": {
        "build": "prisma generate --schema=./prisma/identity/schema.prisma && prisma generate --schema=./prisma/projects/schema.prisma && tsc",
        "clean": "rm -rf dist .turbo",
        "lint": "tsc --noEmit",
        "db:migrate:identity": "prisma migrate dev --schema=./prisma/identity/schema.prisma",
        "db:migrate:projects": "prisma migrate dev --schema=./prisma/projects/schema.prisma",
        "db:push:identity": "prisma db push --schema=./prisma/identity/schema.prisma",
        "db:push:projects": "prisma db push --schema=./prisma/projects/schema.prisma"
    },
    "dependencies": {
        "@prisma/client": "^6.6.0"
    },
    "devDependencies": {
        "prisma": "^6.6.0"
    }
}