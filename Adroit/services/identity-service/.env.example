# Identity Service
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Database
IDENTITY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db_identity

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=7d
